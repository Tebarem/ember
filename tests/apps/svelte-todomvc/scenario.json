{
  "app": "svelte-todomvc",
  "viewport": [800, 600],
  "steps": [
    {"op": "wait-for", "sel": ".todoapp", "ms": 3000, "boot": true},
    {"op": "expect-paint", "n": 2},
    {"op": "expect-count", "sel": ".todo-list li", "n": 0},

    {"op": "type", "sel": ".new-todo", "text": "Buy milk"},
    {"op": "key", "key": "Enter", "code": "Enter"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 1},
    {"op": "expect-text", "sel": ".todo-list li label", "text": "Buy milk"},
    {"op": "expect-text", "sel": ".todo-count", "text": "1 item left"},
    {"op": "expect-value", "sel": ".new-todo", "text": ""},
    {"op": "type", "sel": ".new-todo", "text": "Walk dog"},
    {"op": "key", "key": "Enter", "code": "Enter"},
    {"op": "type", "sel": ".new-todo", "text": "Write code"},
    {"op": "key", "key": "Enter", "code": "Enter"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 3},
    {"op": "expect-text", "sel": ".todo-list li label", "nth": 1, "text": "Walk dog"},
    {"op": "expect-text", "sel": ".todo-list li label", "nth": 2, "text": "Write code"},
    {"op": "expect-text", "sel": ".todo-count", "text": "3 items left"},
    {"op": "expect-storage", "name": "todos-svelte", "text": "Walk dog"},
    {"op": "expect-paint", "n": 15},

    {"op": "click", "sel": ".todo-list li .toggle", "nth": 1},
    {"op": "expect-class", "sel": ".todo-list li", "nth": 1, "text": "completed"},
    {"op": "expect-checked", "sel": ".todo-list li .toggle", "nth": 1},
    {"op": "expect-text", "sel": ".todo-count", "text": "2 items left"},
    {"op": "expect-count", "sel": ".clear-completed", "n": 1},

    {"op": "click", "sel": ".filters a", "nth": 1},
    {"op": "expect-hash", "text": "#/active"},
    {"op": "expect-class", "sel": ".filters a", "nth": 1, "text": "selected"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 2},
    {"op": "navigate", "text": "#/completed"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 1},
    {"op": "expect-text", "sel": ".todo-list li label", "text": "Walk dog"},
    {"op": "expect-class", "sel": ".filters a", "nth": 2, "text": "selected"},
    {"op": "click", "sel": ".filters a", "nth": 0},
    {"op": "expect-hash", "text": "#/"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 3},

    {"op": "dblclick", "sel": ".todo-list li label", "nth": 0},
    {"op": "expect-count", "sel": ".todo-list li.editing", "n": 1},
    {"op": "expect-value", "sel": ".todo-list li.editing .edit", "text": "Buy milk"},
    {"op": "key", "key": "End", "code": "End"},
    {"op": "text", "text": " now"},
    {"op": "key", "key": "Enter", "code": "Enter"},
    {"op": "expect-count", "sel": ".todo-list li.editing", "n": 0},
    {"op": "expect-text", "sel": ".todo-list li label", "nth": 0, "text": "Buy milk now"},
    {"op": "dblclick", "sel": ".todo-list li label", "nth": 1},
    {"op": "expect-count", "sel": ".todo-list li.editing", "n": 1},
    {"op": "text", "text": " zzz"},
    {"op": "key", "key": "Escape", "code": "Escape"},
    {"op": "expect-count", "sel": ".todo-list li.editing", "n": 0},
    {"op": "expect-text", "sel": ".todo-list li label", "nth": 1, "text": "Walk dog"},

    {"op": "click", "sel": "label[for=toggle-all]"},
    {"op": "expect-count", "sel": ".todo-list li.completed", "n": 3},
    {"op": "expect-text", "sel": ".todo-count", "text": "0 items left"},
    {"op": "click", "sel": "label[for=toggle-all]"},
    {"op": "expect-count", "sel": ".todo-list li.completed", "n": 0},
    {"op": "expect-text", "sel": ".todo-count", "text": "3 items left"},

    {"op": "hover", "sel": ".todo-list li", "nth": 0},
    {"op": "click", "sel": ".todo-list li .destroy", "nth": 0},
    {"op": "expect-count", "sel": ".todo-list li", "n": 2},
    {"op": "expect-text", "sel": ".todo-list li label", "nth": 0, "text": "Walk dog"},
    {"op": "expect-text", "sel": ".todo-count", "text": "2 items left"},

    {"op": "click", "sel": ".todo-list li .toggle", "nth": 0},
    {"op": "expect-count", "sel": ".todo-list li.completed", "n": 1},
    {"op": "click", "sel": ".clear-completed"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 1},
    {"op": "expect-count", "sel": ".clear-completed", "n": 0},
    {"op": "expect-text", "sel": ".todo-list li label", "text": "Write code"},
    {"op": "expect-text", "sel": ".todo-count", "text": "1 item left"},
    {"op": "expect-storage", "name": "todos-svelte", "text": "Write code"},

    {"op": "reload"},
    {"op": "wait-for", "sel": ".todo-list li", "ms": 3000},
    {"op": "expect-count", "sel": ".todo-list li", "n": 1},
    {"op": "expect-text", "sel": ".todo-list li label", "text": "Write code"},
    {"op": "expect-text", "sel": ".todo-count", "text": "1 item left"},
    {"op": "navigate", "text": "#/completed"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 0},
    {"op": "navigate", "text": "#/"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 1},
    {"op": "type", "sel": ".new-todo", "text": "After reload"},
    {"op": "key", "key": "Enter", "code": "Enter"},
    {"op": "expect-count", "sel": ".todo-list li", "n": 2},
    {"op": "expect-text", "sel": ".todo-count", "text": "2 items left"},
    {"op": "expect-paint", "n": 15},

    {"op": "eval", "js": "document.activeElement && document.activeElement.blur(); 1"},
    {"op": "wait", "ms": 450},
    {"op": "expect-gold", "sel": ".todoapp", "name": "apps_todomvc_two_active"},
    {"op": "click", "sel": ".todo-list li .toggle", "nth": 1},
    {"op": "expect-count", "sel": ".todo-list li.completed", "n": 1},
    {"op": "eval", "js": "document.activeElement && document.activeElement.blur(); 1"},
    {"op": "hover", "sel": "h1"},
    {"op": "wait", "ms": 600},
    {"op": "expect-gold", "sel": ".todoapp", "name": "apps_todomvc_one_done"}
  ]
}
