var arrObj = [];

function getFunc() {
  return 3;
}
Object.defineProperty(arrObj, "1", {
  get: getFunc,
  configurable: true
});

assert.throws(TypeError, function() {
  arrObj[1] = 4;
});
verifyEqualTo(arrObj, "1", getFunc());

verifyProperty(arrObj, "1", {
  enumerable: false,
  configurable: true,
});