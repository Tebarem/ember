testWithTypedArrayConstructors((TA, makeCtorArg) => {
  var arr = new TA(makeCtorArg([0, 1, 2]));

  assert.throws(RangeError, function() {
    arr.with(3, 7);
  });

  assert.throws(RangeError, function() {
    arr.with(10, 7);
  });

  assert.throws(RangeError, function() {
    arr.with(2 ** 53 + 2, 7);
  });

  assert.throws(RangeError, function() {
    arr.with(Infinity, 7);
  });
});