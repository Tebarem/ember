var obj1 = {
  length: {
    valueOf: function() {
      throw new Test262Error();
    }
  }
};

var obj2 = {
  length: {
    toString: function() {
      throw new Test262Error();
    }
  }
};

assert.throws(Test262Error, function() {
  [].includes.call(obj1);
}, "valueOf");

assert.throws(Test262Error, function() {
  [].includes.call(obj2);
}, "toString");