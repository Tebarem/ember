function* g() {
  yield 0;
  yield 0;
  yield 0;
  yield 1;
}

let iter = g();

let predicateCalls = 0;
iter = iter.filter(v => {
  ++predicateCalls;
  return v;
});

assert.sameValue(predicateCalls, 0);

iter.next();

assert.sameValue(predicateCalls, 4);

iter.next();

assert.sameValue(predicateCalls, 4);