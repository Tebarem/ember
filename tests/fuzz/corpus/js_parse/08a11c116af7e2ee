var getTime = Date.prototype.getTime;
var args = (function() {
  return arguments;
}());

assert.sameValue(typeof getTime, 'function');

assert.throws(TypeError, function() {
  getTime.call({});
}, 'ordinary object');

assert.throws(TypeError, function() {
  getTime.call([]);
}, 'array exotic object');

assert.throws(TypeError, function() {
  getTime.call(args);
}, 'arguments exotic object');