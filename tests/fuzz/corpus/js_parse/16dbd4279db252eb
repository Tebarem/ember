var target = {};
var p = new Proxy(target, {
  defineProperty: function(t, prop, desc) {
    return true;
  }
});

Object.defineProperty(target, "foo", {
  value: 1,
  configurable: true
});

assert.throws(TypeError, function() {
  Object.defineProperty(p, "foo", {
    value: 1,
    configurable: false
  });
});