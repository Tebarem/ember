var uncoercibleFlags = {
  flags: {
    toString: function() {
      throw new Test262Error();
    }
  }
};

assert.throws(Test262Error, function() {
  RegExp.prototype[Symbol.split].call(uncoercibleFlags);
});

uncoercibleFlags = {
  flags: Symbol.split
};

assert.throws(TypeError, function() {
  RegExp.prototype[Symbol.split].call(uncoercibleFlags);
});