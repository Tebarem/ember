var callCount = 0;
var expected = ['x', 'y', 'z'];
var tag = function(templateObject) {
  assert.sameValue(templateObject[0], expected[callCount]);
  callCount++;
  return tag;
}

var result = tag`x``y``z`;

assert.sameValue(callCount, 3);
assert.sameValue(result, tag);