var obj = new Date(0);
obj.prop1 = 100;
obj.prop2 = "prop2";

var tempArray = [];
for (var p in obj) {
  if (obj.hasOwnProperty(p)) {
    tempArray.push(p);
  }
}

var returnedArray = Object.keys(obj);

for (var index in returnedArray) {
  assert.sameValue(tempArray[index], returnedArray[index], 'tempArray[index]');
}