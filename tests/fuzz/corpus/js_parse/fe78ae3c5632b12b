let caught = null;

class C {
  #field;

  constructor() {
    try {
      
      #field in {} << 0;
    } catch (error) {
      caught = error;
    }
  }
}

new C();

assert.notSameValue(caught, null);
assert.sameValue(caught.constructor, TypeError);