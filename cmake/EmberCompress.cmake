# Build-time compression of embedded assets. With EMBER_COMPRESS_ASSETS the shader blobs, the prelude scripts and the
# UA style sheet are stored LZ-compressed (tools/lz, decoded by src/base/lz.c) and expanded where they are used. The
# option defaults to EMBER_MIN_SIZE: it trades a little start-up time (an expansion of 20 to 130 KB, microseconds) for
# a few hundred KB of library.
#
# ember_lz_pack(<out-var> <input> <name> [SPIRV] [DEPENDS <extra>...])
#   Adds a command that writes ${CMAKE_BINARY_DIR}/gen/ember_lz/<name>.lz from <input> (4-byte little-endian raw size, then
#   the stream) and sets <out-var> to that path. Next to it, <name>.lz.h defines the array (see below). The outputs are collected for the ember_lz_assets target
#   (ember_lz_finish() creates it) that the modules depend on. SPIRV: the input is a SPIR-V module whose debug
#   instructions (names, source text) are dropped before it is compressed.
function(ember_lz_pack out_var input name)
    cmake_parse_arguments(_a "SPIRV" "" "DEPENDS" ${ARGN})
    set(_lz_flag "")
    if(_a_SPIRV)
        set(_lz_flag --spirv)
    endif()
    set(_out "${CMAKE_BINARY_DIR}/gen/ember_lz/${name}.lz")
    get_filename_component(_dir "${_out}" DIRECTORY)
    file(MAKE_DIRECTORY "${_dir}")
    add_custom_command(
        OUTPUT "${_out}"
        COMMAND ember_lz ${_lz_flag} "${input}" "${_out}"
        DEPENDS ember_lz "${input}" ${_a_DEPENDS}
        COMMENT "lz ${name}"
        VERBATIM)
    # The header C code includes: the stream as embi_lz_<name with every non-alphanumeric turned into _>. #embed resolves
    # a quoted path against the including file's directory, so the array lives in a header next to the stream.
    string(REGEX REPLACE "[^A-Za-z0-9]" "_" _sym "${name}")
    get_filename_component(_file "${_out}" NAME)
    file(WRITE "${_out}.h.tmp"
        "/* Generated by CMake (cmake/EmberCompress.cmake). Do not edit. */\n"
        "static const unsigned char embi_lz_${_sym}[] = {\n"
        "#embed \"${_file}\"\n"
        "};\n")
    configure_file("${_out}.h.tmp" "${_out}.h" COPYONLY)
    set_property(GLOBAL APPEND PROPERTY EMBER_LZ_OUTPUTS "${_out}")
    set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()

# ember_lz_pack_inc(<name> <inc-file> <array> <width>) 
#   Like ember_lz_pack for a lookup table that lives in a generated .inc file: ember_incbin (tools/lz/incbin.c) writes the
#   elements of <array> as <width>-byte little-endian values to gen/ember_lz/<name>.bin, which is then packed. The C side
#   includes "ember_lz/<name>.lz.h" and expands the stream where the table is read.
function(ember_lz_pack_inc name inc array width)
    set(_bin "${CMAKE_BINARY_DIR}/gen/ember_lz/${name}.bin")
    get_filename_component(_dir "${_bin}" DIRECTORY)
    file(MAKE_DIRECTORY "${_dir}")
    add_custom_command(
        OUTPUT "${_bin}"
        COMMAND ember_incbin "${inc}" "${array}" "${width}" "${_bin}"
        DEPENDS ember_incbin "${inc}"
        COMMENT "incbin ${array}"
        VERBATIM)
    ember_lz_pack(_unused "${_bin}" "${name}" DEPENDS "${_bin}")
endfunction()

function(ember_lz_finish)
    get_property(_outs GLOBAL PROPERTY EMBER_LZ_OUTPUTS)
    add_custom_target(ember_lz_assets DEPENDS ${_outs})
endfunction()
