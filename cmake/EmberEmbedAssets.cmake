# ember_embed_assets(<target> <dir> [NAME <symbol>])
#
# Bakes every file under <dir> (for example a Vite build's dist/) into <target> with C23 #embed, so an app ships as one
# executable with no loose files next to it. It writes two files into the target's binary directory and adds the .c to
# the target:
#
#   <symbol>.h   typedef struct ember_asset { const char *path; const unsigned char *data; size_t size; } ember_asset;
#                extern const ember_asset <symbol>[];   paths are "/index.html", "/assets/index-ab12.js", ...
#                extern const size_t <symbol>_count;     sorted by path, so a lookup can use bsearch
#   <symbol>.c   the table, one #embed per file
#
# <symbol> defaults to <target>_assets. The file list is read at configure time with CONFIGURE_DEPENDS, so a rebuild of
# <dir> that adds or renames files (Vite hashes its file names) reconfigures on the next build; the compiler's
# dependency files track the bytes of each #embed'ed file. Needs GCC 15+ or Clang 19+.
function(ember_embed_assets target dir)
    cmake_parse_arguments(PARSE_ARGV 2 _ea "" "NAME" "")
    if(NOT _ea_NAME)
        set(_ea_NAME "${target}_assets")
    endif()
    get_filename_component(_root "${dir}" ABSOLUTE)
    if(NOT IS_DIRECTORY "${_root}")
        message(FATAL_ERROR "ember_embed_assets: ${_root} is not a directory (build the web app first)")
    endif()
    file(GLOB_RECURSE _files LIST_DIRECTORIES false CONFIGURE_DEPENDS "${_root}/*")
    list(SORT _files)
    if(NOT _files)
        message(FATAL_ERROR "ember_embed_assets: ${_root} has no files")
    endif()

    set(_h "${CMAKE_CURRENT_BINARY_DIR}/${_ea_NAME}.h")
    set(_c "${CMAKE_CURRENT_BINARY_DIR}/${_ea_NAME}.c")
    set(_hdr "#pragma once\n/* Generated by ember_embed_assets from ${_root}. */\n#include <stddef.h>\n\n")
    string(APPEND _hdr "#ifndef EMBER_ASSET_DEFINED\n#define EMBER_ASSET_DEFINED\n")
    string(APPEND _hdr "typedef struct ember_asset {\n    const char *path;\n    const unsigned char *data;\n    size_t size;\n} ember_asset;\n#endif\n\n")
    string(APPEND _hdr "extern const ember_asset ${_ea_NAME}[];\nextern const size_t ${_ea_NAME}_count;\n")

    set(_src "/* Generated by ember_embed_assets from ${_root}. */\n#include \"${_ea_NAME}.h\"\n\n")
    set(_table "")
    set(_i 0)
    foreach(_f IN LISTS _files)
        file(RELATIVE_PATH _rel "${_root}" "${_f}")
        file(SIZE "${_f}" _size)
        # if_empty keeps an empty file a valid (one-byte) array; its size stays 0.
        string(APPEND _src "static const unsigned char a${_i}[] = {\n#embed \"${_f}\" if_empty(0)\n};\n")
        string(APPEND _table "    {\"/${_rel}\", a${_i}, ${_size}},\n")
        math(EXPR _i "${_i} + 1")
    endforeach()
    string(APPEND _src "\nconst ember_asset ${_ea_NAME}[] = {\n${_table}};\nconst size_t ${_ea_NAME}_count = ${_i};\n")

    file(CONFIGURE OUTPUT "${_h}" CONTENT "${_hdr}" @ONLY)
    file(CONFIGURE OUTPUT "${_c}" CONTENT "${_src}" @ONLY)
    target_sources(${target} PRIVATE "${_c}")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
endfunction()
