# Dependencies of module net (N1a): SDL_net (sockets and DNS) and Mbed TLS (TLS), both static, plus the roots.
# Only included when EMBER_NET is ON (the root skips this module otherwise).
#
# Both libraries are configured without Ember warning flags, like SDL_image; sanitizers apply (EMBER_SANITIZE).
# Mbed TLS is built from our own list of sources with its generated files committed (src/net/mbedtls_gen/, see
# tools/mbedtls_gen.sh): the build needs no Python or Perl.
#
# Runs with _mod, _dir and the target ember_${_mod} in scope.

foreach(_dep SDL_net mbedtls)
    if(NOT EXISTS "${CMAKE_SOURCE_DIR}/third_party/${_dep}/CMakeLists.txt")
        message(FATAL_ERROR "${_dep} not found at third_party/${_dep} "
                            "(run: git submodule update --init --recursive third_party/${_dep}, or configure with -DEMBER_NET=OFF)")
    endif()
endforeach()
if(NOT EXISTS "${CMAKE_SOURCE_DIR}/third_party/mbedtls/tf-psa-crypto/core/psa_crypto.c")
    message(FATAL_ERROR "Mbed TLS submodules missing (run: git submodule update --init --recursive third_party/mbedtls, "
                        "or configure with -DEMBER_NET=OFF)")
endif()

if(NOT TARGET SDL3_net-static)
    set(SDLNET_INSTALL OFF CACHE BOOL "" FORCE)
    set(SDLNET_SAMPLES OFF CACHE BOOL "" FORCE)
    set(SDLNET_WERROR OFF CACHE BOOL "" FORCE)
    set(BUILD_SHARED_LIBS OFF)
    add_subdirectory("${CMAKE_SOURCE_DIR}/third_party/SDL_net"
                     "${CMAKE_BINARY_DIR}/third_party/SDL_net" EXCLUDE_FROM_ALL)
    unset(BUILD_SHARED_LIBS)
    # SDL_net uses getaddrinfo and friends, which glibc hides under strict -std=c23 (CMAKE_C_EXTENSIONS is OFF for
    # Ember): build it as gnu23 so the POSIX declarations are visible.
    set_target_properties(SDL3_net-static PROPERTIES POSITION_INDEPENDENT_CODE ON C_EXTENSIONS ON)
    if(WIN32)
        # SDL_net defines static read() and write() wrappers over Winsock; the MinGW-w64 headers of some toolchains
        # (MSYS2 UCRT64) declare the POSIX-named read/write of io.h under gnu23, which conflicts. NO_OLDNAMES keeps
        # the unprefixed CRT names out.
        target_compile_definitions(SDL3_net-static PRIVATE NO_OLDNAMES)
    endif()
    ember_set_sanitizers(SDL3_net-static)
endif()

# The TLS server half of Mbed TLS is only for the tests' server; ON when tests are built (off for size measurements:
# -DEMBER_NET_SERVER=OFF still builds the library and examples, only the net tests then do not link).
set(EMBER_NET_SERVER ${EMBER_TESTS} CACHE BOOL "Build the Mbed TLS server half (the net tests' TLS server)")

if(NOT TARGET ember_mbedtls)
    # Mbed TLS 4.2.0 (TLS, X.509) and TF-PSA-Crypto, built from our own list of sources (no use of Mbed TLS's CMake:
    # no Python, Perl or jinja2 needed to build Ember). The generated sources are committed in mbedtls_gen/ and are
    # regenerated by hand with tools/mbedtls_gen.sh when Mbed TLS is bumped. The list is what our two user configs
    # (mbedtls_user_config.h, crypto_user_config.h) leave enabled; a source whose feature is off would compile to
    # nothing, so it is left out. The server half (ssl_tls12_server.c, ssl_tls13_server.c, ssl_ticket.c) is only for
    # the tests' TLS server, so it is only built (and MBEDTLS_SSL_SRV_C only defined, EMBER_NET_TEST_SERVER) with
    # EMBER_NET_SERVER (default: EMBER_TESTS).
    set(_mb "${CMAKE_SOURCE_DIR}/third_party/mbedtls")
    set(_tf "${_mb}/tf-psa-crypto")
    set(_gen "${_dir}/mbedtls_gen")
    set(_mb_srcs
        ${_gen}/error.c ${_gen}/version_features.c ${_gen}/psa_crypto_driver_wrappers_no_static.c)
    foreach(_f mps_reader ssl_ciphersuites ssl_client ssl_msg ssl_tls ssl_tls12_client ssl_tls13_client
               ssl_tls13_generic ssl_tls13_keys version x509 x509_crt x509_oid)
        list(APPEND _mb_srcs "${_mb}/library/${_f}.c")
    endforeach()
    foreach(_f psa_crypto psa_crypto_client psa_crypto_random psa_crypto_slot_management psa_util tf_psa_crypto_version)
        list(APPEND _mb_srcs "${_tf}/core/${_f}.c")
    endforeach()
    foreach(_f aes aesce aesni bignum bignum_core chacha20 chacha20_neon chachapoly cipher cipher_wrap ctr_drbg ecdsa ecp ecp_curves entropy
               entropy_poll gcm hmac_drbg poly1305 psa_crypto_aead psa_crypto_cipher psa_crypto_ecp psa_crypto_hash
               psa_crypto_mac psa_crypto_rsa psa_util_internal rsa rsa_alt_helpers sha256 sha512)
        list(APPEND _mb_srcs "${_tf}/drivers/builtin/src/${_f}.c")
    endforeach()
    foreach(_f md pk pk_ecc pk_rsa pk_wrap pkparse)
        list(APPEND _mb_srcs "${_tf}/extras/${_f}.c")
    endforeach()
    foreach(_f platform platform_util threading)
        list(APPEND _mb_srcs "${_tf}/platform/${_f}.c")
    endforeach()
    foreach(_f asn1parse asn1write base64 constant_time oid pem)
        list(APPEND _mb_srcs "${_tf}/utilities/${_f}.c")
    endforeach()
    if(EMBER_NET_SERVER)
        foreach(_f ssl_tls12_server ssl_tls13_server ssl_ticket)
            list(APPEND _mb_srcs "${_mb}/library/${_f}.c")
        endforeach()
    endif()

    add_library(ember_mbedtls STATIC ${_mb_srcs})
    set_target_properties(ember_mbedtls PROPERTIES C_STANDARD 99 C_EXTENSIONS ON POSITION_INDEPENDENT_CODE ON)
    target_include_directories(ember_mbedtls PRIVATE
        "${_gen}" "${_mb}/library"
        "${_tf}/core" "${_tf}/drivers/builtin/src" "${_tf}/dispatch" "${_tf}/utilities" "${_tf}/platform" "${_tf}/extras")
    target_include_directories(ember_mbedtls SYSTEM PUBLIC
        "${_mb}/include" "${_tf}/include" "${_tf}/drivers/builtin/include" "${_dir}" "${EMBER_SDL_DIR}/include")
    target_compile_definitions(ember_mbedtls PUBLIC
        "MBEDTLS_USER_CONFIG_FILE=\"${_dir}/mbedtls_user_config.h\""
        "TF_PSA_CRYPTO_USER_CONFIG_FILE=\"${_dir}/crypto_user_config.h\"")
    if(EMBER_NET_SERVER)
        target_compile_definitions(ember_mbedtls PUBLIC EMBER_NET_TEST_SERVER=1)
    endif()
    if(WIN32)
        target_link_libraries(ember_mbedtls PUBLIC bcrypt) # BCryptGenRandom (Mbed TLS's built-in entropy source)
    endif()
    ember_set_sanitizers(ember_mbedtls)
endif()

# Headers of both libraries are third-party: SYSTEM keeps the Ember warning flags off them.
add_library(ember_net_deps INTERFACE)
target_include_directories(ember_net_deps SYSTEM INTERFACE
    "${CMAKE_SOURCE_DIR}/third_party/SDL_net/include"
    "${_dir}")
target_link_libraries(ember_net_deps INTERFACE SDL3_net-static ember_mbedtls)
target_link_libraries(ember_${_mod} PUBLIC ember_net_deps)

# The aggregate library `ember` is built from the module objects, so it links the dependencies itself (the root
# creates `ember` after the module loop: deferred to the end of the root directory; see src/image/module.cmake).
function(_ember_net_link_aggregate)
    if(TARGET ember)
        target_link_libraries(ember PUBLIC ember_net_deps)
    endif()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _ember_net_link_aggregate)
